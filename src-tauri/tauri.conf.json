{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Metahabi POS",
  "version": "0.1.1",
  "identifier": "com.briankrou.pos-logiventa",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Metahabi POS",
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "maximized": true,
        "fullscreen": true,
        "backgroundColor": "#020617"
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPDATA/**/*",
          "$RESOURCE/**",
          "$RESOURCE/**/*"
        ]
      },
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost https://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "es-ES",
        "dialogImagePath": "./assets/installer/wix-dialog.bmp",
        "bannerPath": "./assets/installer/wix-banner.bmp"
      },
      "nsis": {
        "languages": ["Spanish"],
        "sidebarImage": "./assets/installer/nsis-sidebar.bmp",
        "headerImage": "./assets/installer/nsis-header.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzNTI4RjUxMkY4RjY4QjIKUldTeWFJOHZVWTlTMDA2SXlpaXNFTUwrSmxBWEVRMVZWMmtlUm5qbXNKWStXdjZHMllPQ0d4VGUK",
      "endpoints": [
        "https://github.com/krouhub03/POS-Logiventas/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}